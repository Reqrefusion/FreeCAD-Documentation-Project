<div lang="en" dir="ltr" class="mw-content-ltr">
==Scripting==
</div>

<div lang="en" dir="ltr" class="mw-content-ltr">
An example script, projecting a hexagonal wire onto a cylindrical face, then offsetting and extruding the result, is shown below.
</div>

{{Code|code=
#project a hexagonal face onto the surface of a cylinder

import Part

doc = App.ActiveDocument

poly = doc.addObject("Part::RegularPolygon", "RegularPolygon")
poly.Polygon = 6
poly.Circumradius = 2
poly.Placement = App.Placement(App.Vector(0, -10, 5), App.Rotation(App.Vector(1, 0, 0), 90))
face = doc.addObject("Part::Face", "Face")
face.Sources = (poly, )

cyl = App.ActiveDocument.addObject("Part::Cylinder", "Cylinder")
cyl.Radius = 5
cyl.Height = 10

proj = doc.addObject("Part::ProjectOnSurface", "Projection")
proj.SupportFace = (cyl, u"Face1")
proj.Direction = (0, 1, 0)
proj.Mode = u"All"
proj.Projection = (face, u"Face1")
proj.Height = 1  # opposite to projection direction
proj.Offset = -2  # along projection direction

doc.recompute()
}}


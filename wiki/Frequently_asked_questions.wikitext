// Параметры бутылки Dicora 400ml (приблизительные, в мм)
width = 80;       // Ширина бутылки
depth = 45;       // Толщина бутылки
height = 185;     // Высота основного тела
neck_diam = 32;   // Диаметр горлышка
neck_height = 15; // Высота горлышка
r = 15;           // Радиус скругления углов

$fn = 60; // Качество округлостей

// Основное тело бутылки
translate([0, 0, 0])
linear_extrude(height = height)
hull() {
    translate([-(width/2-r), -(depth/2-r), 0]) circle(r);
    translate([ (width/2-r), -(depth/2-r), 0]) circle(r);
    translate([-(width/2-r),  (depth/2-r), 0]) circle(r);
    translate([ (width/2-r),  (depth/2-r), 0]) circle(r);
}

// Горлышко
translate([0, 0, height])
cylinder(d = neck_diam, h = neck_height);
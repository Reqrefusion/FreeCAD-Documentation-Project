.fc-version-toolbar {
    border: 1px solid #a2a9b1;
    border-radius: 6px;
    padding: .8em;
    margin-bottom: 1.2em;
}
.fc-version-buttons { display: flex; flex-wrap: wrap; align-items: center; gap: .4em; }
.fc-version-buttons button {
    font: inherit;
    cursor: pointer;
    color: inherit;
    background: transparent;
    border: 1px solid #72777d;
    border-radius: 4px;
    padding: .3em .65em;
}
.fc-version-buttons button[aria-pressed="true"] {
    background: #36c;
    border-color: #36c;
    color: #fff;
    font-weight: bold;
}
.fc-version-buttons button:focus-visible { outline: 3px solid #36c; outline-offset: 2px; }
.fc-version-status { display: block; margin-top: .5em; font-size: .9em; }
.fc-version-content.fc-version-hidden { display: none !important; }
.fc-version-invalid { outline: 2px dashed #b32424; }
@media print {
    .fc-version-buttons { display: none; }
    .fc-version-toolbar { border: 0; padding: 0; }
}